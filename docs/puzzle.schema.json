{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/persian-crossword.schema.json",
  "title": "Persian Crossword Puzzle",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "title", "description", "size", "entries"],
  "properties": {
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "size": { "const": 8 },
    "entries": {
      "type": "array",
      "minItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "number", "direction", "row", "col", "answer", "clue"],
        "properties": {
          "id": { "type": "string", "pattern": "^[hv][1-8][a-z]$" },
          "number": { "type": "integer", "minimum": 1, "maximum": 8 },
          "direction": { "enum": ["across", "down"] },
          "row": { "type": "integer", "minimum": 0, "maximum": 7 },
          "col": { "type": "integer", "minimum": 0, "maximum": 7 },
          "answer": { "type": "string", "minLength": 2, "pattern": "^[آابپتثجچحخدذرزژسشصضطظعغفقکگلمنوهی]+$" },
          "clue": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$comment": "Application validation additionally enforces bounds, exact row/column numbering, matching crossing letters, at least 40 white cells, full connectivity, and one across plus one down entry per white cell."
}
